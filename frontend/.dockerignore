# Archivos que no deben enviarse al contexto de construcción de Docker:
# se reconstruyen dentro de la imagen y sólo engrosan la compilación.

node_modules
dist
coverage
.git
.gitignore

# Configuración local con datos sensibles.
.env
.env.local
.env.*.local

# Registros y archivos de depuración.
npm-debug.log*
*.log
*.tsbuildinfo

# Editores y sistema operativo.
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Documentación de la aplicación (no interviene en el bundle).
README.md
Dockerfile
.dockerignore
