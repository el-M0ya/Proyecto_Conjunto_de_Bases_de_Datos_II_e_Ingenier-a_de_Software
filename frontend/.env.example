# ---------------------------------------------------------------------------
# Variables de entorno del frontend (Vite)
# ---------------------------------------------------------------------------
# IMPORTANTE: sólo las variables con prefijo `VITE_` se incrustan en el bundle
# del navegador. Nunca se deben colocar aquí secretos, claves privadas ni
# credenciales reales: use el fichero `.env.example` como plantilla y cree un
# `.env.local` (ignorado por Git) con los valores de su máquina.
# ---------------------------------------------------------------------------

# Modo de la aplicación: development | production | test
VITE_APP_ENV=development

# Título mostrado en la interfaz y en los PDF exportados.
VITE_APP_NAME="Base de Batos"

# Ruta base de la API. En desarrollo se recomienda dejarla vacía y usar el proxy
# de Vite (ver VITE_API_PROXY_TARGET) para evitar problemas de CORS.
VITE_API_BASE_URL=/api

# Destino real del proxy en desarrollo (backend Spring Boot / Node).
VITE_API_PROXY_TARGET=http://localhost:8080

# Prefijo que el proxy de Vite reenvía al backend.
VITE_API_PREFIX=/api

# Tiempo máximo de espera de una petición (ms).
VITE_API_TIMEOUT=15000

# Número de intentos automáticos ante fallos de red o respuestas 5xx.
VITE_API_RETRY_COUNT=2

# Idioma y configuración regional por defecto (español de Cuba).
VITE_DEFAULT_LOCALE=es-CU

# Zona horaria usada para formatear fechas en la interfaz.
VITE_DEFAULT_TIMEZONE=America/Havana

# Activa los datos simulados (MSW) en lugar de consumir la API real.
# Útil para desarrollo de la interfaz y para las pruebas de integración.
VITE_ENABLE_MOCKS=false
