generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

/// Grupos musculares que pueden ser trabajados por los ejercicios
enum MuscleGroup {
  PECHO
  ESPALDA
  PIERNAS
  BICEPS
  TRICEPS
  HOMBROS
  ABDOMEN
  GLUTEOS
  ANTEBRAZOS
  PANTORRILLAS
  TRAPECIO
  ISQUIOTIBIALES
}

/// Tipos de ejercicio según su naturaleza
enum ExerciseType {
  FUERZA
  CARDIO
  FLEXIBILIDAD
}

/// Niveles de intensidad de los ejercicios
enum IntensityLevel {
  BAJO
  MEDIO
  ALTO
}

/// Estados del ciclo de vida de una rutina
enum RoutineStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  EN_REVISION
}

/// Estados de una solicitud de ajuste de rutina
enum AdjustmentStatus {
  SOLICITADO
  EN_PROCESO
  COMPLETADO
  RECHAZADO
}

// ============ ENTITIES ============

/// Programa de entrenamiento (ej: "Hipertrofia", "Pérdida de peso")
model Program {
  id            String   @id @default(uuid())
  name          String   @unique
  objective     String
  muscleGroups  MuscleGroup[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routines      Routine[]
  trainers      TrainerProgram[]
  clients       ClientProgram[]

  @@map("programs")
}

/// Entrenador: crea ejercicios, genera y valida rutinas
model Trainer {
  id            String   @id @default(uuid())
  name          String
  specialty     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exercises     Exercise[]
  routines      Routine[]           @relation("RoutineCreator")
  reviewedRoutines Routine[]         @relation("RoutineReviewer")
  trainerPrograms TrainerProgram[]
  adjustments   Adjustment[]

  @@map("trainers")
}

/// Cliente: ejecuta las rutinas asignadas
model Client {
  id            String   @id @default(uuid())
  name          String
  age           Int
  location      String   // Sede a la que pertenece
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routines      ClientRoutine[]
  sessions      Session[]
  clientPrograms ClientProgram[]
  adjustments   Adjustment[]

  @@map("clients")
}

/// Ejercicio: unidad básica de las rutinas
model Exercise {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  muscleGroup   MuscleGroup
  type          ExerciseType
  intensity     IntensityLevel
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     Trainer   @relation(fields: [createdById], references: [id])
  routineExercises RoutineExercise[]

  @@map("exercises")
}

/// Rutina: conjunto de ejercicios con parámetros de generación
model Routine {
  id            String   @id @default(uuid())
  name          String
  status        RoutineStatus @default(PENDIENTE)
  parameters    Json     // Parámetros de generación (proporciones, cobertura, etc.)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  programId     String
  creatorId     String
  reviewerId    String?

  program       Program   @relation(fields: [programId], references: [id])
  creator       Trainer   @relation("RoutineCreator", fields: [creatorId], references: [id])
  reviewer      Trainer?  @relation("RoutineReviewer", fields: [reviewerId], references: [id])
  exercises     RoutineExercise[]
  clientRoutines ClientRoutine[]
  sessions      Session[]
  adjustments   Adjustment[]

  @@map("routines")
}

/// Relación Rutina-Ejercicio con configuración específica
model RoutineExercise {
  id            String   @id @default(uuid())
  order         Int
  sets         Int?
  reps          Int?
  duration      Int?     // En segundos
  restTime      Int?     // En segundos

  routineId     String
  exerciseId    String

  routine       Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise      Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([routineId, exerciseId])
  @@map("routine_exercises")
}

/// Asignación de rutina a cliente
model ClientRoutine {
  id            String   @id @default(uuid())
  assignedAt    DateTime @default(now())
  isActive      Boolean  @default(true)

  clientId      String
  routineId     String

  client        Client   @relation(fields: [clientId], references: [id])
  routine       Routine  @relation(fields: [routineId], references: [id])

  @@unique([clientId, routineId])
  @@map("client_routines")
}

/// Sesión de entrenamiento registrada por el cliente
model Session {
  id            String   @id @default(uuid())
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  notes         String?

  clientId      String
  routineId     String

  client        Client   @relation(fields: [clientId], references: [id])
  routine       Routine  @relation(fields: [routineId], references: [id])

  @@map("sessions")
}

/// Solicitud de ajuste de rutina por parte del cliente
model Adjustment {
  id            String   @id @default(uuid())
  status        AdjustmentStatus @default(SOLICITADO)
  requestReason String
  result        String?  // Resultado del ajuste manual
  requestedAt   DateTime @default(now())
  completedAt   DateTime?

  clientId      String
  routineId     String
  trainerId     String?

  client        Client   @relation(fields: [clientId], references: [id])
  routine       Routine  @relation(fields: [routineId], references: [id])
  trainer       Trainer? @relation(fields: [trainerId], references: [id])

  @@map("adjustments")
}

// ============ RELATION TABLES ============

/// Relación muchos-a-muchos: Entrenadores autorizados por programa
model TrainerProgram {
  trainerId     String
  programId     String

  trainer       Trainer  @relation(fields: [trainerId], references: [id])
  program       Program  @relation(fields: [programId], references: [id])

  @@id([trainerId, programId])
  @@map("trainer_programs")
}

/// Relación muchos-a-muchos: Clientes inscritos en programas
model ClientProgram {
  clientId      String
  programId     String
  enrolledAt    DateTime @default(now())

  client        Client   @relation(fields: [clientId], references: [id])
  program       Program  @relation(fields: [programId], references: [id])

  @@id([clientId, programId])
  @@map("client_programs")
}
