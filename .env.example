# ---------------------------------------------------------------------------
# Variables de entorno del proyecto.
# ---------------------------------------------------------------------------
# Copie este fichero a `.env` y ajuste los valores de su máquina.
#
# `.env` está en el `.gitignore` y NUNCA debe subirse al repositorio: este
# fichero es sólo la plantilla de referencia compartida por el equipo.
# ---------------------------------------------------------------------------

# --- Base de datos relacional ----------------------------------------------
POSTGRES_DB=basedebatos
POSTGRES_USER=basedebatos
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_PORT=5432

# --- Caché -----------------------------------------------------------------
# Cola y caché de la rutina activa, para responder con la menor latencia
# posible durante la sesión de entrenamiento.
REDIS_PORT=6379

# --- Almacén documental de la estructura de las rutinas ---------------------
# Conserva los bloques de cada rutina con su forma propia, sin imponer un
# esquema relacional común.
MONGO_USER=basedebatos
MONGO_PASSWORD=cambiar-en-produccion
MONGO_PORT=27017

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=8080

# --- Backend ---------------------------------------------------------------
# Se completará cuando se implemente el servidor.
# BACKEND_PORT=8081
